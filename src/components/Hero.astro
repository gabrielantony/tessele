---
const frictionPhrases = [
	'um site que exige explicação.',
	'um conteúdo que não conduz.',
	'uma apresentação que não sustenta o valor.',
	'uma marca que parece menor do que a empresa.',
];

const fixedFrictionText = 'Às vezes, o atrito está em';
const firstFrictionPhrase = frictionPhrases[0];
---

<header class="site-header" data-hero-enter="navigation">
	<nav class="site-nav" aria-label="Navegação principal">
		<a class="wordmark" href="/">Tessele</a>
		<div class="nav-links" aria-label="Seções da Tessele">
			<a href="#servicos">Serviços</a>
			<a href="#projetos">Projetos</a>
			<a href="#processo">Processo</a>
		</div>
		<a class="nav-cta" href="#contato">
			<span>Falar com a Tessele</span>
			<span class="nav-cta-icon" aria-hidden="true">
				<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" />
				</svg>
			</span>
		</a>
	</nav>
</header>

<main id="main-content">
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-content">
			<p class="hero-eyebrow" data-hero-enter="eyebrow">
				<span aria-hidden="true"></span>
				ESTÚDIO DE DESIGN, CONTEÚDO E ESTRATÉGIA
			</p>

			<h1 class="hero-title" id="hero-title" data-hero-enter="title">
				<span class="hero-title-line">Sua marca pode ser excelente.</span>
				<span class="hero-title-line">E ainda assim ser difícil de contratar.</span>
			</h1>

			<div class="hero-support" data-hero-enter="support">
				<p class="hero-description">
					A Tessele organiza a mensagem, o design e os pontos de contato para que o cliente entenda seu valor e saiba como avançar.
				</p>

				<p
					class="hero-friction"
					data-typewriter-root
					data-phrases={JSON.stringify(frictionPhrases)}
				>
					<span class="typewriter-visual" aria-hidden="true">
						<span>{fixedFrictionText} </span><span data-typewriter-text>{firstFrictionPhrase}</span><span class="typewriter-cursor">|</span>
					</span>
					{frictionPhrases.map((phrase) => (
						<span class="typewriter-sizer" aria-hidden="true">{fixedFrictionText} {phrase}</span>
					))}
					<span class="sr-only">{fixedFrictionText} {firstFrictionPhrase}</span>
				</p>
			</div>

			<a class="hero-cta" href="#contato" data-hero-enter="cta">Quero entender meu próximo passo</a>
		</div>
	</section>
</main>

<script>
	const typewriterRoot = document.querySelector<HTMLElement>('[data-typewriter-root]');

	if (typewriterRoot) {
		const typewriterText = typewriterRoot.querySelector<HTMLElement>('[data-typewriter-text]');
		const phrases = JSON.parse(typewriterRoot.dataset.phrases ?? '[]') as string[];
		const firstPhrase = phrases[0] ?? '';
		const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		let timer: number | undefined;
		let generation = 0;

		const cancelLoop = () => {
			generation += 1;
			if (timer !== undefined) window.clearTimeout(timer);
			timer = undefined;
		};

		const schedule = (delay: number, callback: () => void, currentGeneration: number) => {
			timer = window.setTimeout(() => {
				if (currentGeneration === generation) callback();
			}, delay);
		};

		const showStaticPhrase = () => {
			if (typewriterText) typewriterText.textContent = firstPhrase;
			typewriterRoot?.removeAttribute('data-typing');
		};

		const startLoop = () => {
			cancelLoop();
			showStaticPhrase();

			if (motionQuery.matches || !typewriterText || phrases.length === 0) return;

			const currentGeneration = generation;
			typewriterRoot.dataset.typing = 'true';
			typewriterText.textContent = '';

			const typePhrase = (phraseIndex: number, characterIndex: number) => {
				const phrase = phrases[phraseIndex];
				typewriterText.textContent = phrase.slice(0, characterIndex);

				if (characterIndex < phrase.length) {
					schedule(55 + Math.random() * 35, () => typePhrase(phraseIndex, characterIndex + 1), currentGeneration);
					return;
				}

				schedule(1600, () => erasePhrase(phraseIndex, phrase.length), currentGeneration);
			};

			const erasePhrase = (phraseIndex: number, characterIndex: number) => {
				const phrase = phrases[phraseIndex];
				typewriterText.textContent = phrase.slice(0, characterIndex);

				if (characterIndex > 0) {
					schedule(28 + Math.random() * 17, () => erasePhrase(phraseIndex, characterIndex - 1), currentGeneration);
					return;
				}

				schedule(300, () => typePhrase((phraseIndex + 1) % phrases.length, 0), currentGeneration);
			};

			schedule(1180, () => typePhrase(0, 0), currentGeneration);
		};

		motionQuery.addEventListener('change', startLoop);
		startLoop();
	}
</script>

<style>
	.site-header {
		position: absolute;
		top: clamp(1rem, 2vw, 2rem);
		left: 50%;
		z-index: 2;
		width: min(calc(100% - (2 * var(--page-gutter))), 66rem);
		transform: translateX(-50%);
	}

	.site-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-4);
		min-height: 5.25rem;
		padding: var(--space-2) var(--space-2) var(--space-2) var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface-glass);
		box-shadow: var(--shadow-floating);
		backdrop-filter: blur(0.875rem);
		-webkit-backdrop-filter: blur(0.875rem);
	}

	.wordmark,
	.nav-links a,
	.nav-cta,
	.hero-cta {
		text-decoration: none;
	}

	.wordmark {
		justify-self: start;
		font-size: clamp(1.25rem, 1.14rem + 0.53vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.055em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: clamp(var(--space-4), 2.5vw, var(--space-8));
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.nav-links a {
		color: var(--color-muted);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.nav-links a:hover {
		color: var(--color-ink);
	}

	.nav-cta,
	.hero-cta {
		border-radius: var(--radius-full);
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: 650;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.nav-cta {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.35rem 0.4rem 0.35rem 1.1rem;
		font-size: var(--text-sm);
		white-space: nowrap;
	}

	.nav-cta-icon {
		display: grid;
		width: 2.25rem;
		aspect-ratio: 1;
		place-items: center;
		border-radius: 50%;
		background: var(--color-on-accent);
		color: var(--color-accent);
	}

	.nav-cta-icon svg {
		width: 1.125rem;
	}

	.hero {
		position: relative;
		display: grid;
		isolation: isolate;
		min-height: 100svh;
		overflow: hidden;
		place-items: center;
		padding: clamp(9rem, 17svh, 12rem) var(--page-gutter) var(--space-12);
		background: var(--color-canvas);
	}

	.hero::before,
	.hero::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		content: '';
		mask-image: linear-gradient(to right, rgb(0 0 0 / 88%), transparent 42%, transparent 58%, rgb(0 0 0 / 88%));
		-webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 88%), transparent 42%, transparent 58%, rgb(0 0 0 / 88%));
	}

	.hero::before {
		background:
			linear-gradient(90deg, var(--color-accent-soft), transparent 17%, transparent 83%, var(--color-accent-soft)),
			repeating-linear-gradient(90deg, transparent 0 7.5rem, var(--color-accent-soft) 7.5rem 10.75rem, transparent 10.75rem 14.5rem);
		filter: blur(0.45rem);
		opacity: 0.86;
		transform: translate3d(-0.35rem, 0, 0);
		animation: side-drift 16s var(--ease-in-out) infinite alternate;
		will-change: transform, opacity;
	}

	.hero::after {
		background:
			radial-gradient(circle at 8% 48%, var(--color-highlight-soft), transparent 27%),
			radial-gradient(circle at 92% 56%, var(--color-accent-soft), transparent 28%);
		opacity: 0.34;
	}

	.hero-content {
		display: flex;
		z-index: 1;
		width: min(100%, 82rem);
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.3;
	}

	.hero-eyebrow > span {
		width: 0.5rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--color-highlight);
	}

	.hero-title {
		max-width: 100%;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.7rem, 4.8vw, 4.75rem);
		font-weight: 400;
		letter-spacing: -0.065em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.hero-title-line {
		display: block;
	}

	.hero-support {
		width: min(100%, 48rem);
		margin-top: clamp(var(--space-6), 3vw, var(--space-8));
	}

	.hero-description {
		max-width: 42rem;
		margin: 0 auto;
		color: var(--color-muted);
		font-size: var(--text-base);
		line-height: 1.6;
	}

	.hero-friction {
		display: grid;
		width: min(100%, 58rem);
		margin: var(--space-6) auto 0;
		color: var(--color-ink);
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.55;
	}

	.typewriter-visual,
	.typewriter-sizer {
		grid-area: 1 / 1;
	}

	.typewriter-sizer {
		visibility: hidden;
	}

	.typewriter-cursor {
		display: none;
		margin-left: 0.12em;
		color: var(--color-highlight);
		animation: cursor-blink 700ms step-end infinite;
	}

	[data-typewriter-root][data-typing='true'] .typewriter-cursor {
		display: inline;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.hero-cta {
		margin-top: clamp(var(--space-8), 4vw, var(--space-12));
		padding: 0.9rem 1.35rem;
		font-size: var(--text-base);
	}

	.nav-cta:hover,
	.hero-cta:hover {
		background: var(--color-accent-hover);
		transform: translateY(-1px);
	}

	.nav-cta:focus-visible,
	.hero-cta:focus-visible {
		outline: 3px solid var(--color-highlight);
		outline-offset: 3px;
	}

	[data-hero-enter] {
		opacity: 0;
		animation: hero-enter var(--duration-editorial) var(--ease-out) both;
	}

	.site-header {
		animation-delay: 80ms;
	}

	.site-header[data-hero-enter] {
		animation-name: navigation-enter;
	}

	.hero-eyebrow {
		animation-delay: 180ms;
	}

	.hero-title {
		animation-delay: 300ms;
	}

	.hero-support {
		animation-delay: 460ms;
	}

	.hero-cta {
		animation-delay: 620ms;
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes navigation-enter {
		from {
			opacity: 0;
			transform: translate(-50%, 0.75rem);
		}

		to {
			opacity: 1;
			transform: translateX(-50%);
		}
	}

	@keyframes side-drift {
		to {
			opacity: 0.7;
			transform: translate3d(0.35rem, 0, 0);
		}
	}

	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}

	@media (min-width: 64rem) {
		.hero-title-line {
			white-space: nowrap;
		}
	}

	@media (max-width: 48rem) {
		.site-nav {
			grid-template-columns: 1fr auto;
			min-height: 4.5rem;
			padding-left: var(--space-4);
		}

		.nav-links {
			display: none;
		}

		.nav-cta {
			gap: var(--space-2);
			padding-left: var(--space-4);
		}

		.nav-cta-icon {
			width: 2rem;
		}

		.hero {
			padding-top: clamp(8rem, 20svh, 10rem);
		}

		.hero::before {
			opacity: 0.48;
		}

		.hero::after {
			opacity: 0.2;
		}
	}

	@media (max-width: 30rem) {
		.site-nav {
			gap: var(--space-2);
		}

		.nav-cta {
			font-size: 0.75rem;
			padding-left: var(--space-3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.hero-eyebrow,
		.hero-title,
		.hero-support,
		.hero-cta {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.site-header {
			transform: translateX(-50%);
		}

		.hero::before,
		.typewriter-cursor {
			animation: none;
		}
	}
</style>
